<?xml version="1.0" encoding="utf-8"?>
<!-- 320x180 TV launcher banner: Sahl emerald with the document mark and name. -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <gradient android:angle="315" android:startColor="#116B54" android:endColor="#07382C" />
            <size android:width="320dp" android:height="180dp" />
        </shape>
    </item>
    <item android:drawable="@drawable/tv_banner_mark" />
</layer-list>
